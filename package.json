{
  "name": "sangeet-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Sangeet - Modern Music Streaming Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install-all": "npm --prefix frontend install && npm --prefix backend install",
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); fs.cpSync('frontend/dist', 'dist', {recursive:true});\"",
    "dev": "npm --prefix frontend run dev",
    "lint": "npm --prefix frontend run lint",
    "start": "node backend/server.js",
    "test": "npm --prefix frontend run lint && npm --prefix backend test"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.4",
    "@rollup/rollup-linux-x64-musl": "^4.52.4",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0"
  },
  "keywords": [
    "music",
    "streaming",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Lakshay Gaur",
  "license": "ISC"
}
